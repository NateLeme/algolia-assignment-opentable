# Copy this file to `.env` and fill in values from
# Algolia dashboard → Settings → API Keys.

# ---- Exposed to the browser (Vite only bundles VITE_-prefixed vars) ----
VITE_ALGOLIA_APP_ID=
# Search-only key: safe to ship to the browser, can only run searches.
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_INDEX_NAME=restaurants

# ---- Server/scripts only — NOT prefixed with VITE_, so never bundled ----
# Admin (or a write-scoped) key: used by the indexing scripts on your machine.
ALGOLIA_ADMIN_KEY=

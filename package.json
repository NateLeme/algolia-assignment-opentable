{
  "name": "opentable-discovery-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenTable-style restaurant search & discovery prototype built on Algolia",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:algolia": "tsx scripts/check-connection.ts",
    "explore:data": "tsx scripts/explore-data.ts",
    "build:records": "tsx scripts/build-records.ts",
    "push:index": "tsx scripts/push-index.ts",
    "test:relevance": "tsx scripts/test-relevance.ts"
  },
  "dependencies": {
    "algoliasearch": "^5.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-instantsearch": "^7.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.0",
    "papaparse": "^5.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
